<Window
    x:Class="LotTrackingWpf.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lot Tracking • Sign in"
    Width="490"
    Height="560"
    MinHeight="500"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Background="#F3F6FA">

    <Grid>
        <Border
            Margin="25"
            Padding="25"
            Background="White"
            CornerRadius="14">

            <StackPanel>

                <!-- Application Header -->
                <TextBlock
                    Text="LOT TRACKING"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="#16283F"/>

                <TextBlock
                    Text="Factory Control • Secure access"
                    Foreground="#64748B"
                    Margin="0,4,0,26"/>

                <!-- Login / Registration Heading -->
                <TextBlock
                    Text="{Binding Heading}"
                    FontSize="19"
                    FontWeight="SemiBold"
                    Margin="0,0,0,18"/>

                <!-- Username -->
                <TextBlock Text="Username"/>

                <TextBox
                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,6,0,16"
                    Height="35"/>

                <!-- Password -->
                <TextBlock Text="Password"/>

                <PasswordBox
                    x:Name="PasswordInput"
                    Margin="0,6,0,12"
                    Height="35"
                    Padding="6"/>

                <!-- Error Message -->
                <TextBlock
                    Text="{Binding Error}"
                    Foreground="#B91C1C"
                    TextWrapping="Wrap"
                    Margin="0,0,0,10"/>

                <!-- Submit Button -->
                <Button
                    x:Name="SubmitButton"
                    Content="Continue"
                    Click="Submit_Click"
                    Background="#16283F"
                    Foreground="White"
                    Height="43"/>

                <!-- Information -->
                <TextBlock
                    Text="First launch: create the initial administrator. Later launches require sign-in."
                    TextWrapping="Wrap"
                    FontSize="11"
                    Foreground="#64748B"
                    Margin="0,16,0,0"/>

            </StackPanel>

        </Border>
    </Grid>
</Window>
